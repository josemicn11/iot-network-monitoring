# Pi-hole
PIHOLE_URL=http://your-pihole-host
PIHOLE_PASSWORD=your-pihole-password

# InfluxDB
INFLUX_URL=http://your-influxdb-host:3302
INFLUX_TOKEN=your-influxdb-token
INFLUX_ORG=TFG
INFLUX_BUCKET=pihole_metrics
SYSTEM_INFLUX_BUCKET=system_metrics

# Grafana email alerts
GF_SMTP_USER=your-email@example.com
GF_SMTP_PASSWORD=your-app-password
GF_SMTP_FROM_ADDRESS=your-email@example.com

# Runtime state
STATE_FILE=last_timestamp.txt

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Ollama
OLLAMA_URL=http://your-ollama-host:11434/api/generate
OLLAMA_MODEL=gemma4:e2b